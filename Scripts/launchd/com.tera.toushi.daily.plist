<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tera.toushi.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tera/Projects/toushi-system/Scripts/run_daily.sh</string>
    </array>

    <!-- 每天 07:30。StartCalendarInterval 在睡眠期间错过时会在唤醒后运行； -->
    <!-- 关机期间错过则不会补跑。RunAtLoad 用于 Agent 加载/用户登录时运行； -->
    <!-- run_daily.py 只有在全部任务成功后才写「当天已成功」，避免重复执行。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/tera/Projects/toushi-system/Logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tera/Projects/toushi-system/Logs/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/tera/Projects/toushi-system</string>
</dict>
</plist>
