<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tera.toushi.events</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tera/Projects/toushi-system/Scripts/run_event_radar.sh</string>
    </array>

    <!-- 每15分钟静默检查；08:00 JST发一次晨报，其余时间仅异常提醒。 -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- 在15分钟轮询之外，确保每天08:00触发一次晨报检查。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/tera/Projects/toushi-system/Logs/launchd.events.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tera/Projects/toushi-system/Logs/launchd.events.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/tera/Projects/toushi-system</string>
</dict>
</plist>
